# ============================================================
#  InSeoul — 통합 환경변수 템플릿
#
#  사용법:
#    cp .env.example .env
#    # 실제 키 값 입력 후 저장
#    make dev
#
#  주의: .env는 절대 Git에 커밋하지 마세요 (.gitignore에 포함됨)
# ============================================================


# ════════════════════════════════════════════════════════════
#  데이터베이스 (MySQL)
#  로컬: make db 로 Docker 컨테이너 자동 생성
#  Docker Compose: mysql 서비스에 자동 반영
# ════════════════════════════════════════════════════════════
DB_USERNAME=root
DB_PASSWORD=root
MYSQL_ROOT_PASSWORD=root


# ════════════════════════════════════════════════════════════
#  Spring Boot — JWT
#  최소 256비트(32바이트) 이상의 랜덤 문자열 권장
#  생성 예시: openssl rand -base64 32
# ════════════════════════════════════════════════════════════
JWT_SECRET=inseoul-dev-secret-key-must-be-at-least-256bits-long-for-hs256


# ════════════════════════════════════════════════════════════
#  Spring Boot — OAuth2 소셜 로그인
#  Kakao: https://developers.kakao.com → 앱 생성 → REST API 키
#  Google: https://console.cloud.google.com → OAuth2 클라이언트 ID
#
#  리다이렉트 URI (각 콘솔에 등록 필요):
#    로컬: http://localhost:8080/login/oauth2/code/kakao
#          http://localhost:8080/login/oauth2/code/google
# ════════════════════════════════════════════════════════════
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 성공 후 프론트엔드 리다이렉트 기준 URL (fragment 방식)
OAUTH2_REDIRECT_URI=http://localhost:5173


# ════════════════════════════════════════════════════════════
#  Spring Boot — 국토부 실거래가 API
#  발급처: https://www.data.go.kr
#  서비스명: 국토교통부_아파트매매 실거래가 상세 자료
#           + 국토교통부_아파트 전월세 자료
#  미설정 시 /api/districts/prices 의 tradeAvg/rentAvg 가 null 반환
# ════════════════════════════════════════════════════════════
MOLIT_API_KEY=


# ════════════════════════════════════════════════════════════
#  FastAPI — RAG 챗봇
#  발급처: https://platform.openai.com → API Keys
#  미설정 시 챗봇 응답 불가
# ════════════════════════════════════════════════════════════
OPENAI_API_KEY=
CHROMA_PERSIST_DIR=./vectorstore


# ════════════════════════════════════════════════════════════
#  서비스 간 통신
#  로컬: Spring이 FastAPI를 http://127.0.0.1:8000 으로 직접 호출
#  Docker Compose: http://fastapi:8000 (컨테이너 내부 DNS)
# ════════════════════════════════════════════════════════════
CHATBOT_URL=http://127.0.0.1:8000


# ════════════════════════════════════════════════════════════
#  프론트엔드 (Vite — VITE_ 접두사 필수)
#  Vite가 자동으로 .env 파일을 읽어 import.meta.env.VITE_* 로 노출
# ════════════════════════════════════════════════════════════
VITE_API_BASE=http://localhost:8080

# 카카오 지도 SDK 키 (브라우저 클라이언트용)
# 발급처: https://developers.kakao.com → 앱 → 플랫폼 → Web 도메인 등록
VITE_KAKAO_MAP_KEY=


# ════════════════════════════════════════════════════════════
#  Docker Compose — 프로덕션 설정
#  make docker-up 또는 docker compose up 시 사용
# ════════════════════════════════════════════════════════════
# 프론트엔드 서빙 도메인 (OAuth2 redirect, CORS 허용 기준)
FRONTEND_URL=http://localhost

# CORS 허용 오리진 (FastAPI용, 쉼표 구분)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
