<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.inseoul.loan.mapper.LoanMapper">

    <resultMap id="loanResultMap" type="com.inseoul.loan.domain.LoanProduct">
        <id     property="prodKey"       column="prod_key"/>
        <result property="name"          column="name"/>
        <result property="type"          column="type"/>
        <result property="rateText"      column="rate_text"/>
        <result property="loanLimit"     column="loan_limit"/>
        <result property="conditionText" column="condition_text"/>
    </resultMap>

    <select id="findAll" resultMap="loanResultMap">
        SELECT prod_key, name, type, rate_text, loan_limit, condition_text
        FROM loan_products
        ORDER BY prod_key
    </select>

</mapper>
