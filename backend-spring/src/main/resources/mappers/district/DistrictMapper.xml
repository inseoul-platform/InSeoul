<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.inseoul.district.mapper.DistrictMapper">

    <resultMap id="districtResultMap" type="com.inseoul.district.domain.District">
        <id     property="code"        column="code"/>
        <result property="region"      column="region"/>
        <result property="lat"         column="lat"/>
        <result property="lng"         column="lng"/>
        <result property="tierDefault" column="tier_default"/>
    </resultMap>

    <select id="findAll" resultMap="districtResultMap">
        SELECT code, region, lat, lng, tier_default FROM districts ORDER BY code
    </select>

    <select id="findByCode" resultMap="districtResultMap">
        SELECT code, region, lat, lng, tier_default FROM districts WHERE code = #{code}
    </select>

</mapper>
