<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.inseoul.auth.mapper.RefreshTokenMapper">

    <resultMap id="tokenResultMap" type="com.inseoul.auth.domain.RefreshToken">
        <id     property="id"         column="id"/>
        <result property="userId"     column="user_id"/>
        <result property="tokenHash"  column="token_hash"/>
        <result property="expiresAt"  column="expires_at"/>
        <result property="revoked"    column="revoked"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO refresh_tokens (user_id, token_hash, expires_at, revoked)
        VALUES (#{userId}, #{tokenHash}, #{expiresAt}, 0)
    </insert>

    <select id="findByTokenHash" resultMap="tokenResultMap">
        SELECT * FROM refresh_tokens WHERE token_hash = #{tokenHash}
    </select>

    <update id="revokeByTokenHash">
        UPDATE refresh_tokens SET revoked = 1 WHERE token_hash = #{tokenHash}
    </update>

    <update id="revokeAllByUserId">
        UPDATE refresh_tokens SET revoked = 1 WHERE user_id = #{userId} AND revoked = 0
    </update>

</mapper>
