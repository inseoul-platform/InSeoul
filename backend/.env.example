# ============================================================
#  FastAPI 환경변수
#
#  ⚠️  이 파일은 더 이상 별도로 사용하지 않습니다.
#  프로젝트 루트의 .env.example 을 참고해 루트에 .env 파일을 생성하세요.
#
#    cd ..
#    cp .env.example .env
#    # OPENAI_API_KEY 등 값 입력
#
#  FastAPI(main.py)는 시작 시 자동으로 루트 .env 를 읽습니다.
#  Docker Compose 환경에서는 docker-compose.yml 의 environment 섹션으로 주입됩니다.
# ============================================================

# 아래는 참고용 변수 목록 (루트 .env 에 입력)
OPENAI_API_KEY=
CHROMA_PERSIST_DIR=./vectorstore
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
